DATABASE_URL="postgresql://postgres:postgres@localhost:5433/realtime_workspace?schema=public"
JWT_SECRET="change-me-in-production"

# Local dev runs without PUSHER_* and uses the Socket.io server (server.js).
# Production / Vercel MUST set these: the app then uses Pusher instead.
# PUSHER_APP_ID=
# PUSHER_KEY=
# PUSHER_SECRET=
# PUSHER_CLUSTER=eu
# NEXT_PUBLIC_PUSHER_KEY=
# NEXT_PUBLIC_PUSHER_CLUSTER=eu

PORT=3000

# Public URL used to build absolute OpenGraph/Twitter image URLs.
# NEXT_PUBLIC_APP_URL=https://liveboard-chi.vercel.app
