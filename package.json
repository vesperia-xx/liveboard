{
  "name": "realtime-team-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Realtime collaborative workspace: Kanban, presence, activity feed and offline-aware sync.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.js",
    "build": "prisma generate && next build",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@prisma/client": "^5.19.0",
    "@tanstack/react-query": "^5.107.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.17",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.4.6",
    "pusher": "^5.3.4",
    "pusher-js": "^8.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "prisma": "^5.19.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
